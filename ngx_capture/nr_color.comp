#version 450
layout(local_size_x=8,local_size_y=8) in;
layout(binding=0) uniform sampler2D originalColor;
layout(binding=1) uniform sampler2D exposureTexture;
layout(binding=2) uniform sampler2D encodedColor;
layout(binding=3) uniform sampler2D modelColor;
layout(binding=4,rgba16f) writeonly uniform image2D target;
layout(push_constant) uniform Push { uint mode; uint width; uint height; float preExposure; } p;
vec3 toSrgb(vec3 x) { return mix(12.92*x,1.055*pow(max(x,0),vec3(1./2.4))-.055,greaterThan(x,vec3(.0031308))); }
vec3 toLinear(vec3 x) { return mix(x/12.92,pow((max(x,0)+.055)/1.055,vec3(2.4)),greaterThan(x,vec3(.04045))); }
void main() {
    ivec2 pos=ivec2(gl_GlobalInvocationID.xy);
    if(pos.x>=p.width || pos.y>=p.height) return;
    vec4 source=texelFetch(originalColor,pos,0);
    float exposure=texelFetch(exposureTexture,ivec2(0),0).r;
    bool valid=exposure>0 && !isinf(exposure) && !isnan(exposure) && p.preExposure>0;
    float scale=valid?exposure/p.preExposure:1;
    vec3 exposed=max(source.rgb,0)*scale;
    float peak=max(exposed.r,max(exposed.g,exposed.b));
    vec3 proxy=toSrgb(exposed/(1+peak));
    if(p.mode==0) { imageStore(target,pos,vec4(proxy,source.a)); return; }
    // Transfer only the model's edit. An unchanged model reproduces the original
    // HDR signal, including negative channels and alpha, without inverse poles.
    vec3 before=toLinear(texelFetch(encodedColor,pos,0).rgb);
    vec3 after=toLinear(clamp(texelFetch(modelColor,pos,0).rgb,0,1));
    vec3 edit=(after-before)*(1+peak)/scale;
    vec3 limit=max(abs(source.rgb)*2,vec3(.1/scale));
    vec3 result=source.rgb+clamp(edit,-limit,limit);
    if(!valid || any(isnan(result)) || any(isinf(result))) result=source.rgb;
    imageStore(target,pos,vec4(clamp(result,-65504,65504),source.a));
}
